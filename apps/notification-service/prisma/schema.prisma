generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "cjs"
  engineType   = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// In-app notifications. Email/SMS delivery needs a provider decision and is intentionally not implemented.
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      String
  title     String
  body      String
  data      Json      @default("{}")
  sourceEventId String? @db.Uuid
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model ProcessedEvent {
  eventId      String   @db.Uuid
  consumerName String
  processedAt  DateTime @default(now()) @db.Timestamptz(3)

  @@id([eventId, consumerName])
}
