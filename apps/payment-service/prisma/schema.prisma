generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "cjs"
  engineType   = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REQUIRES_REVIEW
}

model Payment {
  id                String        @id @db.Uuid
  orderId           String        @unique @db.Uuid
  amountMinor       Int
  currency          String        @db.Char(3)
  status            PaymentStatus @default(PENDING)
  provider          String        @default("sandbox")
  providerReference String?
  failureReason     String?
  correlationId     String        @db.Uuid
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
}

/// Provider event ids already handled; makes webhook retries and replays harmless.
model WebhookEvent {
  providerEventId String   @id
  type            String
  receivedAt      DateTime @default(now()) @db.Timestamptz(3)
}

/// Transactional outbox: written in the same transaction as the state change, published to Kafka by the relay.
model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  eventId       String    @unique @db.Uuid
  eventType     String
  aggregateId   String    @db.Uuid
  version       Int       @default(1)
  correlationId String    @db.Uuid
  causationId   String?   @db.Uuid
  payload       Json
  status        String    @default("PENDING")
  retryCount    Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @db.Timestamptz(3)
  lockedUntil   DateTime? @db.Timestamptz(3)
  lastAttemptAt DateTime? @db.Timestamptz(3)
  lastError     String?
  publishedAt   DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@index([status, nextAttemptAt, createdAt])
}

/// Consumer deduplication: inserting (eventId, consumerName) is the first step of every handler transaction.
model ProcessedEvent {
  eventId      String   @db.Uuid
  consumerName String
  processedAt  DateTime @default(now()) @db.Timestamptz(3)

  @@id([eventId, consumerName])
}
