# Copy to .env and fill in. Generate every secret with:  openssl rand -hex 32
# The stack refuses to start if a required value is missing, and production boots refuse placeholder values.

# --- Database (hex only; the password is interpolated into SQL by infrastructure/postgres/init.sh)
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# --- Shared secrets (>= 32 characters each, all different)
JWT_ACCESS_SECRET=
INTERNAL_SERVICE_TOKEN=
PAYMENT_WEBHOOK_SECRET=

# --- First administrator, created on first boot if the account does not exist (password >= 12 chars)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Optional
HTTP_PORT=8080
LOG_LEVEL=info
# Browser origins allowed to call /api directly (comma separated). Leave empty for same-origin only.
CORS_ORIGINS=
# Raise to 3 with a 3-broker Kafka cluster
KAFKA_REPLICATION_FACTOR=1

# --- Website (public content, not secrets)
SITE_URL=https://shop.example.com        # canonical URL used in sitemap, robots and social tags
SITE_NAME=Shop
COMPANY_NAME=Shop Ltd
CONTACT_EMAIL=support@example.com        # shown on the privacy policy and terms pages
GOVERNING_LAW=India
# Optional privacy-friendly analytics (Plausible-compatible). Loaded only after the visitor accepts cookies.
ANALYTICS_DOMAIN=
ANALYTICS_SCRIPT_URL=https://plausible.io/js/script.js
# Optional: serve static assets from a CDN (set at BUILD time, e.g. https://cdn.example.com)
CDN_URL=
# Force http -> https at nginx (needs a TLS-terminating load balancer that sets X-Forwarded-Proto)
FORCE_HTTPS=true
